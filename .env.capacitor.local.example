# Template for .env.capacitor.local (gitignored).
#
#   cp .env.capacitor.local.example .env.capacitor.local
#
# Only CAPACITOR_SERVER_URL is read from this file, by capacitor.config.ts. A
# real environment variable always takes precedence, so you can also just do:
#
#   CAPACITOR_SERVER_URL=https://<preview>.vercel.app pnpm ios:preview
#
# The URL below is a PLACEHOLDER. Replace it with the Vercel preview deployment
# for your branch — find it on the PR's "View deployment" link, or with:
#
#   gh pr view 56 --json url && vercel ls
#
# Must be a bare origin: scheme + host, no path, no query string.
# Preview URLs are not committed: they are branch-scoped, short-lived, and change
# on every deployment.
CAPACITOR_SERVER_URL=https://groundwork-pro-git-your-branch-your-scope.vercel.app
