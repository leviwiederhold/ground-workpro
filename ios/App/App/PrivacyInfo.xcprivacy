<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest for the Groundwork Pro app target.

	  Scope: this file declares only what THIS target does. Third-party SDKs
	  (Capacitor, GoogleSignIn-iOS, GTMSessionFetcher, AppAuth, Alamofire) ship
	  their own PrivacyInfo.xcprivacy inside their frameworks and Apple
	  aggregates them into the final privacy report — they are deliberately not
	  restated here.

	  Every declaration below is backed by an actual behaviour in this app; see
	  the per-entry comments. Nothing speculative is declared.
	-->

	<!--
	  No tracking: the app does not link user data with third-party data for
	  advertising/measurement, and contains no ad or analytics SDK.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Required-reason APIs: none used by this target's own code. AppDelegate.swift
	  uses only WKWebView/WKWebsiteDataStore APIs, which are not in Apple's
	  required-reason categories. SDKs declare their own (e.g. GoogleSignIn
	  declares UserDefaults CA92.1).
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  Email address — collected at sign-in via Supabase auth (Sign in with
		  Apple, Google, or email/password). Identifies the account.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Name — returned by Apple/Google on first authorization and stored on the
		  employee profile so teammates can identify each other.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  User ID — the Supabase account identifier that owns the user's records.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Precise location — jobsite arrival/departure detection for attendance.
		  Backed by NSLocationWhenInUseUsageDescription in Info.plist.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Photos — profile photo capture/selection. Backed by
		  NSCameraUsageDescription and NSPhotoLibraryUsageDescription in Info.plist.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
