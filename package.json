{
  "name": "groundwork-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check-env && pnpm build:next",
    "start": "next start",
    "cap:sync": "pnpm exec cap sync",
    "cap:open:ios": "pnpm exec cap open ios",
    "ios:sync": "node scripts/ios-sync.mjs",
    "ios:preview": "node scripts/ios-sync.mjs --preview",
    "ios:open": "pnpm exec cap open ios",
    "cap:open:android": "pnpm exec cap open android",
    "android:sync": "pnpm exec cap sync android",
    "android:bundle": "cd android && ./gradlew bundleRelease -PgroundworkReleaseBuild=true",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --test --experimental-strip-types \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test",
    "test:e2e:spec": "playwright test --workers=1",
    "check:fast": "pnpm lint && pnpm typecheck",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "verify": "pnpm lint && pnpm build && pnpm test:e2e",
    "ci:local": "pnpm install && pnpm verify",
    "check-env": "node scripts/check-env.js",
    "security:audit": "node scripts/security-audit.mjs",
    "check-schema": "node scripts/check-schema.js",
    "build:next": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm exec next typegen && tsc --noEmit --incremental false",
    "apple:secret": "node scripts/generate-apple-secret.js",
    "auth:contract": "node scripts/check-production-auth-contract.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/geolocation": "^8",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/push-notifications": "^8",
    "@capgo/capacitor-social-login": "^8.3.37",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@sentry/nextjs": "^9.11.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "chart.js": "^4.5.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "next": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.1.1",
    "tus-js-client": "4.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.51.1",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9 <10"
  }
}
